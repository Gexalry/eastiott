{%- assign lunch_product = all_products['the-atelier-lunch-box'] -%}
{%- assign lunch_variant = lunch_product.variants.first -%}

<div class="east-cart-drawer" id="EastCartDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Your bag">
  <div class="ecd-backdrop" data-ecd-close aria-hidden="true"></div>
  <aside class="ecd-panel">
    <header class="ecd-head">
      <span class="ecd-title">Your bag <em id="EastCartCount" aria-live="polite">0</em></span>
      <button type="button" class="ecd-close" data-ecd-close aria-label="Close cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </header>

    <div class="ecd-body">
      <div class="ecd-empty"{% if cart.items.size > 0 %} hidden{% endif %}>
        <p>Your bag is quietly empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="ecd-keep">Continue shopping</a>
      </div>
      <ul class="ecd-items" id="EastCartItems">
        {%- for item in cart.items -%}
          <li class="ecd-row" data-key="{{ item.key }}" data-qty="{{ item.quantity }}" data-unit="{{ item.final_price }}" data-unit-orig="{{ item.original_price }}">
            <div class="ecd-thumb">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 140 }}" width="70" height="70" alt="" loading="lazy" decoding="async">
              {%- endif -%}
            </div>
            <div class="ecd-row-body">
              <div class="ecd-row-top">
                <span class="ecd-row-name">{{ item.product_title }}</span>
                <button class="ecd-remove" type="button" data-key="{{ item.key }}" aria-label="Remove {{ item.product_title | escape }} from cart"><span aria-hidden="true">×</span></button>
              </div>
              {%- if item.variant.title != 'Default Title' -%}<div class="ecd-row-variant">{{ item.variant.title }}</div>{%- endif -%}
              <div class="ecd-row-bottom">
                <div class="ecd-qty">
                  <button class="ecd-qty-btn" type="button" data-key="{{ item.key }}" data-delta="-1" aria-label="Decrease quantity of {{ item.product_title | escape }}"><span aria-hidden="true">−</span></button>
                  <span class="ecd-qty-n" aria-label="Quantity: {{ item.quantity }}">{{ item.quantity }}</span>
                  <button class="ecd-qty-btn" type="button" data-key="{{ item.key }}" data-delta="1" aria-label="Increase quantity of {{ item.product_title | escape }}"><span aria-hidden="true">+</span></button>
                </div>
                <div class="ecd-line-price">
                  {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s> {%- endif -%}
                  {{ item.final_line_price | money }}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if lunch_variant -%}
        <div class="ecd-upsell" id="EastCartUpsell" data-variant-id="{{ lunch_variant.id }}" hidden>
          <div class="ecd-upsell-label">Pair it with</div>
          <div class="ecd-upsell-card">
            <div class="ecd-upsell-img">
              {%- if lunch_product.featured_image -%}
                <img src="{{ lunch_product.featured_image | image_url: width: 200 }}" alt="{{ lunch_product.title | escape }}" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.4" aria-hidden="true" focusable="false"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/><path d="M8 12h8"/></svg>
              {%- endif -%}
            </div>
            <div class="ecd-upsell-info">
              <div class="ecd-upsell-name">{{ lunch_product.title }}</div>
              <div class="ecd-upsell-sub">Slips into the insulated compartment</div>
              <div class="ecd-upsell-price">
                {{ lunch_variant.price | money }}
                {%- if lunch_variant.compare_at_price > lunch_variant.price -%}
                  <s>{{ lunch_variant.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
            </div>
            <button type="button" class="ecd-upsell-add" id="EastUpsellAdd" aria-label="Add {{ lunch_product.title | escape }} to cart">Add</button>
          </div>
        </div>
      {%- endif -%}
    </div>

    <footer class="ecd-foot" id="EastCartFoot"{% if cart.items.size == 0 %} hidden{% endif %}>
      <div class="ecd-sub">
        <span>Subtotal</span>
        <span id="EastCartTotal">{{ cart.total_price | money }}</span>
      </div>
      <div class="ecd-ship">Taxes & shipping calculated at checkout</div>
      <a href="{{ routes.checkout_url }}" id="EastCheckoutBtn" class="ecd-checkout">Check out</a>
    </footer>
  </aside>
</div>

<script>
(function(){
  if(window.eastiottCart)return;
  var drawer=document.getElementById('EastCartDrawer');
  if(!drawer)return;
  var itemsEl=drawer.querySelector('#EastCartItems');
  var emptyEl=drawer.querySelector('.ecd-empty');
  var footEl=drawer.querySelector('#EastCartFoot');
  var countEl=drawer.querySelector('#EastCartCount');
  var totalEl=drawer.querySelector('#EastCartTotal');
  var upsellEl=drawer.querySelector('#EastCartUpsell');
  var upsellAdd=drawer.querySelector('#EastUpsellAdd');
  var checkoutBtn=drawer.querySelector('#EastCheckoutBtn');
  var lunchVariantId=upsellEl?parseInt(upsellEl.dataset.variantId,10):null;

  var activeCurrency='{{ localization.country.currency.iso_code | default: "USD" }}';
  var moneyFmt;
  try{moneyFmt=new Intl.NumberFormat((navigator&&navigator.language)||'en-US',{style:'currency',currency:activeCurrency});}catch(e){moneyFmt=null;}
  function money(c){
    if(moneyFmt)return moneyFmt.format(c/100);
    return '{{ shop.money_format }}'.replace(/\{\{\s*amount[^}]*\}\}/,(c/100).toFixed(2));
  }
  function escapeHtml(s){var d=document.createElement('div');d.textContent=s==null?'':s;return d.innerHTML;}
  function thumb(url,w){if(!url)return '';return url+(url.indexOf('?')>-1?'&':'?')+'width='+w;}
  function updateHeaderCount(n){
    var el=document.getElementById('EastHeaderCartCount');
    if(el)el.textContent=String(n);
  }

  var lastCart=null;
  var pendingUpdates={};
  var flushTimer=null;
  var inFlight=false;
  var refreshToken=0;
  var lastFocused=null;

  function recomputeFromDom(){
    if(!lastCart)return;
    var rows=itemsEl.querySelectorAll('.ecd-row');
    var totalQty=0,totalCents=0;
    rows.forEach(function(row){
      var key=row.dataset.key;
      var qty=parseInt(row.dataset.qty,10)||0;
      totalQty+=qty;
      var unit=parseInt(row.dataset.unit,10)||0;
      var unitOrig=parseInt(row.dataset.unitOrig,10)||unit;
      var line=unit*qty;
      var lineOrig=unitOrig*qty;
      totalCents+=line;
      var priceEl=row.querySelector('.ecd-line-price');
      if(priceEl){
        priceEl.innerHTML=(lineOrig>line?'<s>'+money(lineOrig)+'</s> ':'')+money(line);
      }
    });
    countEl.textContent='('+totalQty+')';
    updateHeaderCount(totalQty);
    totalEl.textContent=money(totalCents);
    if(totalQty===0){emptyEl.hidden=false;footEl.hidden=true;if(upsellEl)upsellEl.hidden=true;}
  }

  function render(cart){
    lastCart=cart;
    var items=cart&&cart.items||[];
    var totalQty=items.reduce(function(n,i){return n+i.quantity;},0);
    countEl.textContent='('+totalQty+')';
    updateHeaderCount(totalQty);
    if(items.length===0){
      emptyEl.hidden=false;
      itemsEl.innerHTML='';
      footEl.hidden=true;
      if(upsellEl)upsellEl.hidden=true;
      return;
    }
    emptyEl.hidden=true;
    footEl.hidden=false;
    totalEl.textContent=money(cart.total_price);
    var hasLunch=items.some(function(i){return i.variant_id===lunchVariantId;});
    if(upsellEl)upsellEl.hidden=hasLunch;
    itemsEl.innerHTML=items.map(function(item){
      var img=item.featured_image&&item.featured_image.url?item.featured_image.url:'';
      var variantLabel=item.variant_title&&item.variant_title!=='Default Title'?item.variant_title:'';
      var line=item.final_line_price;
      var originalLine=item.original_line_price;
      var save=originalLine>line?originalLine-line:0;
      var unit=item.final_price||(item.quantity?Math.round(line/item.quantity):0);
      var unitOrig=item.original_price||(item.quantity?Math.round(originalLine/item.quantity):unit);
      var itemLabel=escapeHtml(item.product_title);
      return ''
        +'<li class="ecd-row" data-key="'+escapeHtml(item.key)+'" data-qty="'+item.quantity+'" data-unit="'+unit+'" data-unit-orig="'+unitOrig+'">'
        +'  <div class="ecd-thumb">'+(img?'<img src="'+escapeHtml(thumb(img,140))+'" width="70" height="70" alt="" loading="lazy" decoding="async">':'')+'</div>'
        +'  <div class="ecd-row-body">'
        +'    <div class="ecd-row-top">'
        +'      <span class="ecd-row-name">'+itemLabel+'</span>'
        +'      <button class="ecd-remove" type="button" data-key="'+escapeHtml(item.key)+'" aria-label="Remove '+itemLabel+' from cart"><span aria-hidden="true">×</span></button>'
        +'    </div>'
        +(variantLabel?'<div class="ecd-row-variant">'+escapeHtml(variantLabel)+'</div>':'')
        +'    <div class="ecd-row-bottom">'
        +'      <div class="ecd-qty">'
        +'        <button class="ecd-qty-btn" type="button" data-key="'+escapeHtml(item.key)+'" data-delta="-1" aria-label="Decrease quantity of '+itemLabel+'"><span aria-hidden="true">−</span></button>'
        +'        <span class="ecd-qty-n" aria-label="Quantity: '+item.quantity+'">'+item.quantity+'</span>'
        +'        <button class="ecd-qty-btn" type="button" data-key="'+escapeHtml(item.key)+'" data-delta="1" aria-label="Increase quantity of '+itemLabel+'"><span aria-hidden="true">+</span></button>'
        +'      </div>'
        +'      <div class="ecd-line-price">'
        +(save>0?'<s>'+money(originalLine)+'</s> ':'')
        +money(line)
        +'</div>'
        +'    </div>'
        +'  </div>'
        +'</li>';
    }).join('');
  }

  function refresh(){
    var token=++refreshToken;
    return fetch('{{ routes.cart_url }}.js',{headers:{'Accept':'application/json'}})
      .then(function(r){if(!r.ok)throw new Error('cart fetch failed: '+r.status);return r.json();})
      .then(function(cart){
        // Only apply if this is still the latest in-flight refresh — avoids stale renders racing
        if(token!==refreshToken)return;
        render(cart);
      })
      .catch(function(err){try{if(window.console&&console.warn)console.warn('[east-cart] refresh failed:',err);}catch(_){}});
  }
  function focusFirst(){
    try{
      var sel='button:not([disabled]),a[href],input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
      var first=drawer.querySelector('.ecd-close')||drawer.querySelector(sel);
      if(first&&typeof first.focus==='function')first.focus();
    }catch(_){}
  }
  function open(){
    try{lastFocused=document.activeElement;}catch(_){lastFocused=null;}
    drawer.classList.add('on');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';
    refresh();
    // Defer focus to after the drawer transitions in / paints
    setTimeout(focusFirst,30);
  }
  function close(){
    drawer.classList.remove('on');drawer.setAttribute('aria-hidden','true');document.body.style.overflow='';
    try{if(lastFocused&&typeof lastFocused.focus==='function')lastFocused.focus();}catch(_){}
    lastFocused=null;
  }

  function flushUpdates(){
    if(inFlight)return;
    var updates=pendingUpdates;
    if(Object.keys(updates).length===0)return;
    pendingUpdates={};
    inFlight=true;
    fetch('{{ routes.cart_url }}/update.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({updates:updates})})
      .then(function(r){if(!r.ok)throw new Error('update failed: '+r.status);return r.json();})
      .then(function(cart){
        // Invalidate any in-flight refresh — this server response is now authoritative
        refreshToken++;
        render(cart);
      })
      .catch(function(err){
        try{if(window.console&&console.warn)console.warn('[east-cart] update failed, refetching:',err);}catch(_){}
        refresh();
      })
      .then(function(){
        inFlight=false;
        if(Object.keys(pendingUpdates).length>0)scheduleFlush(0);
      });
  }
  function scheduleFlush(delay){
    if(flushTimer)clearTimeout(flushTimer);
    flushTimer=setTimeout(flushUpdates,delay==null?180:delay);
  }
  function queueChange(key,qty,row){
    if(!key)return;
    qty=Math.max(0,qty|0);
    pendingUpdates[key]=qty;
    if(row){
      row.dataset.qty=qty;
      var nEl=row.querySelector('.ecd-qty-n');if(nEl)nEl.textContent=qty;
      if(qty<=0){
        row.style.transition='opacity .18s ease, height .18s ease, padding .18s ease, margin .18s ease';
        row.style.opacity='0';
        row.style.pointerEvents='none';
        // Disable buttons inside so repeated rapid clicks can't keep firing on a removed row
        row.querySelectorAll('button').forEach(function(b){b.disabled=true;});
      }
    }
    recomputeFromDom();
    scheduleFlush();
  }

  function addItems(items){
    if(!items||!items.length)return Promise.resolve();
    return fetch('{{ routes.cart_url }}/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
      .then(function(r){if(!r.ok)throw new Error('add failed: '+r.status);return r.json();})
      .then(function(){return refresh();});
  }

  drawer.addEventListener('click',function(e){
    var t=e.target.closest('[data-ecd-close]');if(t){e.preventDefault();close();return;}
    var q=e.target.closest('.ecd-qty-btn');
    if(q){
      if(q.disabled)return;
      var row=q.closest('.ecd-row');
      if(!row||!row.dataset.key)return;
      var key=row.dataset.key;
      var delta=parseInt(q.dataset.delta,10);
      if(isNaN(delta))return;
      var current=parseInt(row.dataset.qty,10);
      if(isNaN(current))current=1;
      var next=current+delta;
      // Don't fire updates that don't change anything
      if(next===current)return;
      // Floor at 0 — a remove is fine but we don't want negatives queued
      if(next<0)next=0;
      queueChange(key,next,row);
      return;
    }
    var rm=e.target.closest('.ecd-remove');
    if(rm){
      if(rm.disabled)return;
      var row2=rm.closest('.ecd-row');
      if(!row2||!row2.dataset.key)return;
      queueChange(row2.dataset.key,0,row2);
      return;
    }
  });
  if(upsellAdd){upsellAdd.addEventListener('click',function(){
    if(!lunchVariantId)return;
    if(upsellEl)upsellEl.hidden=true;
    upsellAdd.disabled=true;
    addItems([{id:lunchVariantId,quantity:1}]).catch(function(){if(upsellEl)upsellEl.hidden=false;upsellAdd.disabled=false;});
  });}
  document.addEventListener('keydown',function(e){
    if(!drawer.classList.contains('on'))return;
    if(e.key==='Escape'){close();return;}
    if(e.key==='Tab'){
      try{
        var sel='button:not([disabled]),a[href],input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
        var nodes=drawer.querySelectorAll(sel);
        var focusable=[];
        for(var i=0;i<nodes.length;i++){var n=nodes[i];if(n.offsetParent!==null||n===document.activeElement)focusable.push(n);}
        if(!focusable.length)return;
        var firstF=focusable[0],lastF=focusable[focusable.length-1];
        if(e.shiftKey&&document.activeElement===firstF){e.preventDefault();lastF.focus();}
        else if(!e.shiftKey&&document.activeElement===lastF){e.preventDefault();firstF.focus();}
      }catch(_){}
    }
  });

  window.eastiottCart={open:open,close:close,refresh:refresh,addItems:function(items){return addItems(items).then(open);}};
  document.addEventListener('click',function(e){
    var trigger=e.target.closest('[data-east-cart-open], a[href$="/cart"]');
    if(trigger){
      var href=trigger.getAttribute('href');
      if(trigger.matches('[data-east-cart-open]') || (href && /\/cart$/.test(href))){
        e.preventDefault();open();
      }
    }
  });
})();
</script>
