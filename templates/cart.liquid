<div class="east-checkout-trust">
  <div class="ct-wrap">
    <div class="ct-brand">EASTIOTT</div>
    <div class="ct-pill">
      <div class="ct-avs" aria-hidden="true">
        <span style="background:#cdbfa6"></span>
        <span style="background:#6b4e34"></span>
        <span style="background:#4F5B65"></span>
      </div>
      <span class="ct-pill-text"><b>54,000+</b> carried worldwide</span>
    </div>
    <ul class="ct-badges">
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2 4 6v6c0 5 3.4 9.5 8 11 4.6-1.5 8-6 8-11V6l-8-4Z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Secure Checkout</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>30-Day Guarantee</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
        <span>Tracked Worldwide</span>
      </li>
    </ul>
  </div>
</div>

<style>
  .east-checkout-trust { background: var(--paper-2); border-bottom: 1px solid var(--line); padding: 30px 0 26px; }
  .east-checkout-trust .ct-wrap { max-width: 1080px; margin: 0 auto; padding: 0 var(--wrap-pad); display:flex; flex-direction:column; align-items:center; gap: 18px; }
  .east-checkout-trust .ct-brand { font-family: var(--serif); font-size: 30px; font-weight: 600; letter-spacing: .32em; color: var(--blue); padding-left: .32em; text-transform: uppercase; }
  .east-checkout-trust .ct-pill { display:flex; align-items:center; gap: 14px; background:#fff; border:1px solid var(--line); border-radius: 999px; padding: 8px 22px 8px 12px; }
  .east-checkout-trust .ct-avs { display:flex; }
  .east-checkout-trust .ct-avs span { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--gold); display:inline-block; margin-left: -8px; }
  .east-checkout-trust .ct-avs span:first-child { margin-left: 0; }
  .east-checkout-trust .ct-pill-text { font-family: var(--sans); font-size: 14px; color: var(--ink); letter-spacing: .03em; }
  .east-checkout-trust .ct-pill-text b { color: var(--blue); font-weight: 600; }
  .east-checkout-trust .ct-badges { list-style:none; padding:0; margin:0; display:flex; gap: 40px; flex-wrap: wrap; justify-content: center; }
  .east-checkout-trust .ct-badges li { display:flex; align-items:center; gap: 9px; font-size: 12.5px; letter-spacing: .08em; color: var(--slate); text-transform: uppercase; }
  .east-checkout-trust .ct-badges svg { width: 22px; height: 22px; color: var(--blue); }
  @media (max-width: 640px) {
    .east-checkout-trust .ct-brand { font-size: 22px; letter-spacing: .24em; padding-left: .24em; }
    .east-checkout-trust .ct-badges { gap: 22px; }
    .east-checkout-trust .ct-badges li { font-size: 11px; letter-spacing: .06em; }
  }
</style>

<section class="wrap" style="padding:48px 28px 72px;max-width:1080px;">
  <h1 style="font-family:var(--serif);font-size:48px;font-weight:500;margin-bottom:36px;">Your cart</h1>
  {% if cart.item_count == 0 %}
    <p style="color:var(--slate);margin-bottom:24px;">Your cart is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" style="display:inline-block;background:var(--blue);color:#fff;padding:14px 28px;border-radius:4px;letter-spacing:.18em;text-transform:uppercase;font-size:13px;">Continue shopping</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="border-bottom:1px solid var(--line);text-align:left;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate);">
            <th style="padding:14px 0;">Product</th>
            <th style="padding:14px 0;">Quantity</th>
            <th style="padding:14px 0;text-align:right;">Total</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr style="border-bottom:1px solid var(--line);">
              <td style="padding:18px 0;">
                <div style="display:flex;gap:16px;align-items:center;">
                  {% if item.image %}<img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" style="width:70px;height:70px;object-fit:cover;border-radius:3px;">{% endif %}
                  <div>
                    <a href="{{ item.url }}" style="font-family:var(--serif);font-size:18px;font-weight:600;">{{ item.product.title }}</a>
                    {% if item.product.has_only_default_variant == false %}<div style="font-size:12px;color:var(--slate);">{{ item.variant.title }}</div>{% endif %}
                    <div style="font-size:13px;color:var(--blue);margin-top:4px;">{{ item.original_price | money }}</div>
                  </div>
                </div>
              </td>
              <td style="padding:18px 0;">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;padding:8px;border:1px solid var(--line);border-radius:3px;">
              </td>
              <td style="padding:18px 0;text-align:right;font-weight:500;">{{ item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:32px;flex-wrap:wrap;gap:20px;">
        <button type="submit" name="update" style="background:none;border:1px solid var(--line);padding:12px 22px;border-radius:3px;letter-spacing:.14em;text-transform:uppercase;font-size:12px;cursor:pointer;">Update</button>
        <div style="text-align:right;">
          <div style="font-family:var(--serif);font-size:28px;color:var(--blue);">{{ cart.total_price | money }}</div>
          <div style="font-size:12px;color:var(--slate);letter-spacing:.04em;">Subtotal · taxes & shipping at checkout</div>
        </div>
      </div>
      <div style="text-align:right;margin-top:20px;">
        <button type="submit" name="checkout" style="background:var(--blue);color:#fff;border:none;padding:16px 36px;border-radius:4px;letter-spacing:.2em;text-transform:uppercase;font-size:13px;font-weight:500;cursor:pointer;">Check out</button>
      </div>
    </form>
  {% endif %}
</section>
