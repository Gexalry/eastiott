<section class="wrap" style="padding:72px 28px;max-width:1080px;">
  <h1 style="font-family:var(--serif);font-size:48px;font-weight:500;margin-bottom:36px;">Your cart</h1>
  {% if cart.item_count == 0 %}
    <p style="color:var(--slate);margin-bottom:24px;">Your cart is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" style="display:inline-block;background:var(--blue);color:#fff;padding:14px 28px;border-radius:4px;letter-spacing:.18em;text-transform:uppercase;font-size:13px;">Continue shopping</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="border-bottom:1px solid var(--line);text-align:left;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate);">
            <th style="padding:14px 0;">Product</th>
            <th style="padding:14px 0;">Quantity</th>
            <th style="padding:14px 0;text-align:right;">Total</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr style="border-bottom:1px solid var(--line);">
              <td style="padding:18px 0;">
                <div style="display:flex;gap:16px;align-items:center;">
                  {% if item.image %}<img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" style="width:70px;height:70px;object-fit:cover;border-radius:3px;">{% endif %}
                  <div>
                    <a href="{{ item.url }}" style="font-family:var(--serif);font-size:18px;font-weight:600;">{{ item.product.title }}</a>
                    {% if item.product.has_only_default_variant == false %}<div style="font-size:12px;color:var(--slate);">{{ item.variant.title }}</div>{% endif %}
                    <div style="font-size:13px;color:var(--blue);margin-top:4px;">{{ item.original_price | money }}</div>
                  </div>
                </div>
              </td>
              <td style="padding:18px 0;">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;padding:8px;border:1px solid var(--line);border-radius:3px;">
              </td>
              <td style="padding:18px 0;text-align:right;font-weight:500;">{{ item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:32px;flex-wrap:wrap;gap:20px;">
        <button type="submit" name="update" style="background:none;border:1px solid var(--line);padding:12px 22px;border-radius:3px;letter-spacing:.14em;text-transform:uppercase;font-size:12px;cursor:pointer;">Update</button>
        <div style="text-align:right;">
          <div style="font-family:var(--serif);font-size:28px;color:var(--blue);">{{ cart.total_price | money }}</div>
          <div style="font-size:12px;color:var(--slate);letter-spacing:.04em;">Subtotal · taxes & shipping at checkout</div>
        </div>
      </div>
      <div style="text-align:right;margin-top:20px;">
        <button type="submit" name="checkout" style="background:var(--blue);color:#fff;border:none;padding:16px 36px;border-radius:4px;letter-spacing:.2em;text-transform:uppercase;font-size:13px;font-weight:500;cursor:pointer;">Check out</button>
      </div>
    </form>
  {% endif %}
</section>
