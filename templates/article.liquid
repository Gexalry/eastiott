<article class="wrap" style="max-width:780px;padding:72px 28px;">
  <header style="text-align:center;margin-bottom:48px;">
    <div style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;">{{ article.published_at | date: '%B %-d, %Y' }}</div>
    <h1 style="font-family:var(--serif);font-size:48px;font-weight:500;line-height:1.05;margin-bottom:10px;">{{ article.title }}</h1>
    {% if article.excerpt != blank %}<p style="font-family:var(--serif);font-style:italic;font-size:20px;color:var(--slate);">{{ article.excerpt | strip_html }}</p>{% endif %}
  </header>
  <div class="rte" style="font-size:16px;line-height:1.7;color:var(--ink);">{{ article.content }}</div>
  {% if blog.comments_enabled? %}
    <section style="margin-top:64px;padding-top:32px;border-top:1px solid var(--line);">
      <h2 style="font-family:var(--serif);font-size:28px;margin-bottom:20px;">Comments</h2>
      {% paginate article.comments by 10 %}
        {% for comment in article.comments %}
          <div style="padding:16px 0;border-bottom:1px solid var(--line);">
            <div style="font-size:13px;color:var(--slate);margin-bottom:6px;">{{ comment.author }} · {{ comment.created_at | date: '%b %-d, %Y' }}</div>
            <div>{{ comment.content }}</div>
          </div>
        {% endfor %}
        {{ paginate | default_pagination }}
      {% endpaginate %}
    </section>
  {% endif %}
</article>
