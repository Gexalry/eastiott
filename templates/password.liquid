<section class="wrap" style="padding:120px 28px;text-align:center;max-width:520px;">
  <h1 style="font-family:var(--serif);font-size:48px;font-weight:500;margin-bottom:12px;">{{ shop.name }}</h1>
  <p style="font-family:var(--serif);font-style:italic;font-size:18px;color:var(--slate);margin-bottom:36px;">Opening soon.</p>

  {% form 'storefront_password' %}
    <label for="Password" style="display:block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--slate);margin-bottom:10px;">Enter store password</label>
    <input type="password" name="password" id="Password" style="width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:3px;font-size:15px;margin-bottom:12px;">
    <button type="submit" style="width:100%;background:var(--blue);color:#fff;border:none;padding:14px;border-radius:4px;letter-spacing:.2em;text-transform:uppercase;font-size:13px;font-weight:500;cursor:pointer;">Enter</button>
    {% if form.errors %}<div style="color:var(--red);font-size:13px;margin-top:12px;">{{ form.errors | default_errors }}</div>{% endif %}
  {% endform %}

  <div style="margin-top:48px;">
    {% form 'customer', class: 'east-news-form' %}
      <input type="hidden" name="contact[tags]" value="prospect">
      <label style="display:block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--slate);margin-bottom:10px;">Be the first to know</label>
      <input type="email" name="contact[email]" placeholder="Your email address" required style="width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:3px;font-size:14px;margin-bottom:10px;">
      <button type="submit" style="width:100%;background:var(--gold);color:#fff;border:none;padding:12px;border-radius:4px;letter-spacing:.16em;text-transform:uppercase;font-size:12px;cursor:pointer;">Notify me</button>
      {% if form.posted_successfully? %}<div style="color:var(--gold);font-size:13px;margin-top:10px;">Thank you — you're on the list.</div>{% endif %}
    {% endform %}
  </div>
</section>
