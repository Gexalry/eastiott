<section class="wrap" style="padding:72px 28px;">
  <header style="text-align:center;margin-bottom:48px;">
    <h1 style="font-family:var(--serif);font-size:54px;font-weight:500;">{{ blog.title }}</h1>
  </header>
  {% paginate blog.articles by 12 %}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:32px;">
      {% for article in blog.articles %}
        <a href="{{ article.url }}" style="display:block;">
          {% if article.image %}
            <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape | default: article.title | escape }}" style="aspect-ratio:4/3;object-fit:cover;width:100%;border-radius:3px;margin-bottom:14px;" loading="lazy">
          {% endif %}
          <div style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;">{{ article.published_at | date: '%B %-d, %Y' }}</div>
          <h2 style="font-family:var(--serif);font-size:24px;font-weight:600;line-height:1.15;">{{ article.title }}</h2>
        </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:48px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
</section>
