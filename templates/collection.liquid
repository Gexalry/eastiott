<section class="wrap" style="padding:72px 28px;">
  <header style="text-align:center;margin-bottom:48px;">
    {% if collection.description != blank %}
      <div style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;">The Collection</div>
    {% endif %}
    <h1 style="font-family:var(--serif);font-size:54px;font-weight:500;">{{ collection.title }}</h1>
    {% if collection.description != blank %}<div style="font-family:var(--serif);font-style:italic;font-size:18px;color:var(--slate);max-width:560px;margin:14px auto 0;">{{ collection.description }}</div>{% endif %}
  </header>
  {% paginate collection.products by 24 %}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:30px;">
      {% for product in collection.products %}
        <a href="{{ product.url }}" style="display:block;">
          {% if product.featured_image %}
            <div style="aspect-ratio:1;overflow:hidden;border-radius:3px;background:var(--paper-2);margin-bottom:14px;">
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape | default: product.title | escape }}" style="width:100%;height:100%;object-fit:cover;transition:transform .6s ease;" loading="lazy">
            </div>
          {% endif %}
          <h3 style="font-family:var(--serif);font-size:20px;font-weight:600;margin-bottom:4px;">{{ product.title }}</h3>
          <div style="font-size:14px;color:var(--blue);">{{ product.price | money }}</div>
        </a>
      {% else %}
        <p style="grid-column:1/-1;text-align:center;color:var(--slate);">No products in this collection.</p>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:48px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
</section>
