<section class="wrap" style="padding:72px 28px;">
  <h1 style="font-family:var(--serif);font-size:48px;font-weight:500;text-align:center;margin-bottom:48px;">Collections</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:30px;">
    {% for collection in collections %}
      <a href="{{ collection.url }}" style="display:block;">
        {% if collection.image %}
          <div style="aspect-ratio:4/3;overflow:hidden;border-radius:3px;background:var(--paper-2);margin-bottom:14px;">
            <img src="{{ collection.image | image_url: width: 800 }}" alt="{{ collection.image.alt | escape | default: collection.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
          </div>
        {% endif %}
        <h2 style="font-family:var(--serif);font-size:24px;font-weight:600;">{{ collection.title }}</h2>
      </a>
    {% endfor %}
  </div>
</section>
