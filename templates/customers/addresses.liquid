<section class="wrap" style="padding:72px 28px;max-width:780px;">
  <header style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:32px;flex-wrap:wrap;gap:16px;">
    <h1 style="font-family:var(--serif);font-size:38px;font-weight:500;">Your addresses</h1>
    <a href="{{ routes.account_url }}" style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);">← Back to account</a>
  </header>

  {% paginate customer.addresses by 6 %}
    {% for address in customer.addresses %}
      <div style="border:1px solid var(--line);border-radius:4px;padding:20px;margin-bottom:14px;">
        <div style="font-family:var(--serif);font-size:18px;font-weight:600;margin-bottom:6px;">{{ address.first_name }} {{ address.last_name }}{% if address == customer.default_address %} <span style="font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-left:8px;">Default</span>{% endif %}</div>
        <div style="font-size:14px;color:var(--slate);line-height:1.6;">{{ address.company }}<br>{{ address.street }}<br>{{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>{{ address.country }}</div>
      </div>
    {% endfor %}
    <div style="text-align:center;margin-top:24px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
</section>
