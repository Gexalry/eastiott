<section class="wrap" style="padding:80px 28px;max-width:480px;">
  <h1 style="font-family:var(--serif);font-size:42px;font-weight:500;text-align:center;margin-bottom:32px;">Sign in</h1>
  {% form 'customer_login' %}
    {{ form.errors | default_errors }}
    <label style="display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Email</label>
    <input type="email" name="customer[email]" autofocus required style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:3px;margin-bottom:14px;">
    <label style="display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Password</label>
    <input type="password" name="customer[password]" required style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:3px;margin-bottom:18px;">
    <button type="submit" style="width:100%;background:var(--blue);color:#fff;border:none;padding:14px;border-radius:4px;letter-spacing:.2em;text-transform:uppercase;font-size:13px;font-weight:500;cursor:pointer;">Sign in</button>
  {% endform %}
  <div style="display:flex;justify-content:space-between;margin-top:18px;font-size:13px;">
    <a href="#recover" style="color:var(--slate);">Forgot password?</a>
    <a href="{{ routes.account_register_url }}" style="color:var(--blue);">Create account</a>
  </div>
  <div id="recover" style="margin-top:48px;padding-top:32px;border-top:1px solid var(--line);">
    <h2 style="font-family:var(--serif);font-size:22px;margin-bottom:14px;">Reset your password</h2>
    {% form 'recover_customer_password' %}
      {% if form.posted_successfully? %}<p style="color:var(--gold);">We've sent you an email with a link to update your password.</p>{% endif %}
      {{ form.errors | default_errors }}
      <input type="email" name="email" placeholder="Your email" required style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:3px;margin-bottom:10px;">
      <button type="submit" style="width:100%;background:none;border:1px solid var(--line);padding:12px;border-radius:4px;letter-spacing:.16em;text-transform:uppercase;font-size:12px;cursor:pointer;">Send reset link</button>
    {% endform %}
  </div>
</section>
