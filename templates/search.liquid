<section class="wrap" style="padding:72px 28px;">
  <header style="text-align:center;margin-bottom:36px;">
    <h1 style="font-family:var(--serif);font-size:48px;font-weight:500;">Search</h1>
  </header>
  <form action="{{ routes.search_url }}" method="get" style="max-width:520px;margin:0 auto 48px;display:flex;gap:10px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?" style="flex:1;padding:14px 16px;border:1px solid var(--line);border-radius:3px;font-size:15px;">
    <button type="submit" style="background:var(--blue);color:#fff;border:none;padding:14px 22px;border-radius:3px;letter-spacing:.14em;text-transform:uppercase;font-size:12px;">Search</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p style="text-align:center;color:var(--slate);">No results for "{{ search.terms | escape }}".</p>
    {% else %}
      <p style="text-align:center;color:var(--slate);margin-bottom:32px;">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms | escape }}"</p>
      {% paginate search.results by 24 %}
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:30px;">
          {% for item in search.results %}
            <a href="{{ item.url }}" style="display:block;">
              {% if item.featured_image %}
                <div style="aspect-ratio:1;overflow:hidden;border-radius:3px;background:var(--paper-2);margin-bottom:12px;">
                  <img src="{{ item.featured_image | image_url: width: 800 }}" alt="{{ item.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
                </div>
              {% endif %}
              <h3 style="font-family:var(--serif);font-size:20px;font-weight:600;">{{ item.title }}</h3>
              {% if item.object_type == 'product' %}<div style="font-size:14px;color:var(--blue);">{{ item.price | money }}</div>{% endif %}
            </a>
          {% endfor %}
        </div>
        <div style="text-align:center;margin-top:48px;">{{ paginate | default_pagination }}</div>
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>
