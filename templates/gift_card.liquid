<section class="wrap" style="padding:72px 28px;text-align:center;max-width:560px;">
  <div style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;">Gift Card</div>
  <h1 style="font-family:var(--serif);font-size:42px;font-weight:500;margin-bottom:18px;">{{ gift_card.balance | money_without_trailing_zeros }}</h1>
  <p style="color:var(--slate);margin-bottom:24px;">Use this code at checkout:</p>
  <code style="display:inline-block;padding:14px 22px;background:var(--paper-2);border-radius:4px;font-size:18px;letter-spacing:.2em;">{{ gift_card.code | format_code }}</code>
  <div style="margin-top:32px;">
    <a href="{{ gift_card.pass_url }}" style="display:inline-block;background:var(--blue);color:#fff;padding:14px 28px;border-radius:4px;letter-spacing:.14em;text-transform:uppercase;font-size:12px;">Add to Apple Wallet</a>
  </div>
</section>
