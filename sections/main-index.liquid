<section class="hero" style="padding: {{ section.settings.padding }}px 24px;">
  <div class="hero__inner">
    <h1>{{ section.settings.heading | default: shop.name }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <a class="hero__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A new store, just getting started." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 16, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
