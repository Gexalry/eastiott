<section class="east-features">
  <div class="wrap">
    <div class="fhead reveal">
      <div class="line"><h2>{{ section.settings.heading_pre }} <b>{{ section.settings.heading_emphasis }}</b></h2></div>
      {%- if section.settings.subheading != blank -%}
        <div class="sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- assign fallback_1 = 'https://d8j0ntlcm91z4.cloudfront.net/user_3CM0Z4osHXlzGBZ3LIRDjXy1o8z/hf_20260523_014302_2cf5916f-ea85-40b3-8c23-8fe5b9b4d1c6.png' -%}
    {%- assign fallback_2 = 'https://d8j0ntlcm91z4.cloudfront.net/user_3CM0Z4osHXlzGBZ3LIRDjXy1o8z/hf_20260523_014314_d222ab38-bbbd-4ca8-bbdd-18de2cf9ddc3.png' -%}
    {%- assign fallback_3 = 'https://d8j0ntlcm91z4.cloudfront.net/user_3CM0Z4osHXlzGBZ3LIRDjXy1o8z/hf_20260522_044750_14b8c2f2-a3f2-40ea-af10-4eedaa1dcea5.png' -%}
    {%- assign fallback_4 = 'https://d8j0ntlcm91z4.cloudfront.net/user_3CM0Z4osHXlzGBZ3LIRDjXy1o8z/hf_20260523_014325_e65a8f98-1853-44ce-9d91-9eab4d176a6a.png' -%}

    <div class="fg">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- case forloop.index -%}
            {%- when 1 -%}{%- assign fallback_src = fallback_1 -%}
            {%- when 2 -%}{%- assign fallback_src = fallback_2 -%}
            {%- when 3 -%}{%- assign fallback_src = fallback_3 -%}
            {%- when 4 -%}{%- assign fallback_src = fallback_4 -%}
            {%- else -%}{%- assign fallback_src = '' -%}
          {%- endcase -%}
          <article class="fc reveal" {{ block.shopify_attributes }}>
            <div class="img">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape | default: block.settings.title | escape }}" loading="lazy">
              {%- elsif fallback_src != blank -%}
                <img src="{{ fallback_src }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <span class="no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign default_titles = 'An Insulated Home for Lunch|A Padded Sleeve for Your Laptop|A Hidden Anti-Theft Pocket|A Leak-Proof, Easy-Clean Lining' | split: '|' -%}
        {%- assign default_bodies = 'A built-in thermal compartment keeps meals warm for 5 hours and cold for 10, sealed away from the rest of your day. No separate lunch bag, ever again.|A protective, padded compartment cradles laptops up to 17 inches and holds them secure, so your tech travels safely from the office to the airport.|A concealed pocket sits flat against the back panel, keeping your phone, wallet, and passport out of sight and out of reach in a crowd.|The food compartment is fully leak-proof and isolated, with a smooth lining that wipes clean in seconds. Spills stay contained, never near your laptop.' | split: '|' -%}
        {%- for i in (0..3) -%}
          {%- assign idx = i | plus: 1 -%}
          {%- case idx -%}
            {%- when 1 -%}{%- assign fallback_src = fallback_1 -%}
            {%- when 2 -%}{%- assign fallback_src = fallback_2 -%}
            {%- when 3 -%}{%- assign fallback_src = fallback_3 -%}
            {%- when 4 -%}{%- assign fallback_src = fallback_4 -%}
          {%- endcase -%}
          <article class="fc reveal">
            <div class="img">
              <img src="{{ fallback_src }}" alt="{{ default_titles[i] | escape }}" loading="lazy">
            </div>
            <span class="no">{{ idx | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ default_titles[i] }}</h3>
            <p>{{ default_bodies[i] }}</p>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .east-features { padding: 90px 0 96px; }
  .east-features .fhead { text-align: center; margin-bottom: 58px; }
  .east-features .fhead .line { display:flex; align-items:center; justify-content:center; gap:24px; margin-bottom:14px; }
  .east-features .fhead .line::before, .east-features .fhead .line::after { content:""; height:1px; width:120px; background:var(--line); }
  .east-features .fhead h2 { font-family: var(--serif); font-size: 46px; font-weight: 600; letter-spacing: 0.01em; }
  .east-features .fhead h2 b { color: var(--blue); font-weight: 600; }
  .east-features .fhead .sub { font-family: var(--serif); font-style: italic; font-size: 21px; color: var(--slate); }

  .east-features .fg { display: grid; grid-template-columns: repeat(4,1fr); gap: 30px; }
  @media (max-width:980px) { .east-features .fg { grid-template-columns: repeat(2,1fr); gap: 40px 30px; } }
  @media (max-width:540px) { .east-features .fg { grid-template-columns: 1fr; max-width: 380px; margin: 0 auto; } }

  .east-features .fc .img {
    aspect-ratio: 1; border-radius: 5px; overflow: hidden;
    background: var(--paper-2); position: relative; margin-bottom: 22px;
  }
  .east-features .fc .img img { width:100%; height:100%; object-fit:cover; transition: transform .6s ease; }
  .east-features .fc:hover .img img { transform: scale(1.04); }
  .east-features .fc .img::after { content:""; position:absolute; inset:0; box-shadow: inset 0 0 0 1px var(--line); border-radius: 5px; }
  .east-features .fc .no { font-family: var(--serif); font-size: 13px; letter-spacing: 0.18em; color: var(--gold); margin-bottom: 8px; display: block; }
  .east-features .fc h3 { font-family: var(--serif); font-size: 25px; font-weight: 600; line-height: 1.12; margin-bottom: 12px; }
  .east-features .fc p { font-size: 14.5px; line-height: 1.64; color: var(--slate); }
</style>

{% schema %}
{
  "name": "Four features grid",
  "settings": [
    { "type": "text", "id": "heading_pre", "label": "Heading (regular)", "default": "Four" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (emphasized — blue)", "default": "Features" },
    { "type": "text", "id": "subheading", "label": "Subheading (italic)", "default": "the kind only a woman would think to include" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "An Insulated Home for Lunch" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "A built-in thermal compartment keeps meals warm for 5 hours and cold for 10, sealed away from the rest of your day." }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "title": "An Insulated Home for Lunch", "body": "A built-in thermal compartment keeps meals warm for 5 hours and cold for 10, sealed away from the rest of your day. No separate lunch bag, ever again." } },
      { "type": "feature", "settings": { "title": "A Padded Sleeve for Your Laptop", "body": "A protective, padded compartment cradles laptops up to 17\" and holds them secure, so your tech travels safely from the office to the airport." } },
      { "type": "feature", "settings": { "title": "A Hidden Anti-Theft Pocket", "body": "A concealed pocket sits flat against the back panel, keeping your phone, wallet, and passport out of sight and out of reach in a crowd." } },
      { "type": "feature", "settings": { "title": "A Leak-Proof, Easy-Clean Lining", "body": "The food compartment is fully leak-proof and isolated, with a smooth lining that wipes clean in seconds. Spills stay contained, never near your laptop." } }
    ]
  }
}
{% endschema %}
