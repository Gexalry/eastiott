<header class="site-header">
  <div class="wrap nav">
    <div class="nav-icons">
      <a href="{{ routes.search_url }}">Search</a>
    </div>
    <a class="logo" href="{{ routes.root_url }}">{{ section.settings.logo_text | default: shop.name }}</a>
    <div class="nav-icons">
      {%- render 'currency-selector' -%}
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </div>
  </div>
</header>

{%- render 'currency-auto-detect' -%}

{%- if section.blocks.size > 0 -%}
  <div class="site-subnav">
    <div class="wrap row">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Eastiott"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The Collection" },
        { "type": "url", "id": "link", "label": "URL" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "The Collection", "link": "/collections/the-eastiott-collection" } },
      { "type": "link", "settings": { "label": "The Atelier Tote", "link": "/products/the-atelier-tote" } },
      { "type": "link", "settings": { "label": "Travel", "link": "/collections/the-eastiott-collection" } },
      { "type": "link", "settings": { "label": "Materials", "link": "/pages/materials" } },
      { "type": "link", "settings": { "label": "Our Story", "link": "/pages/about" } }
    ]
  }
}
{% endschema %}
