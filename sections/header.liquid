<header class="site-header" role="banner">
  <nav class="wrap nav" aria-label="Primary">
    <div class="nav-icons nav-left">
      <button type="button" class="east-burger" id="EastBurger" aria-expanded="false" aria-controls="EastMobileNav" aria-label="Open menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <a href="{{ routes.search_url }}" class="nav-search">Search</a>
    </div>
    <a class="logo" href="{{ routes.root_url }}" rel="home">{{ section.settings.logo_text | default: shop.name }}</a>
    <div class="nav-icons">
      {%- render 'currency-selector' -%}
      <a href="{{ routes.account_url }}" class="nav-account">Account</a>
      <a href="{{ routes.cart_url }}" id="EastHeaderCart" data-east-cart-open>Cart (<span id="EastHeaderCartCount" aria-live="polite" aria-atomic="true">{{ cart.item_count }}</span><span class="visually-hidden"> items</span>)</a>
    </div>
  </nav>
</header>

{%- render 'currency-auto-detect' -%}

{%- if section.blocks.size > 0 -%}
  <nav class="site-subnav" aria-label="Collections">
    <div class="wrap row">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
  </nav>
  <div class="east-mobile-nav" id="EastMobileNav" aria-hidden="true">
    <div class="emn-backdrop" data-emn-close aria-hidden="true"></div>
    <aside class="emn-panel" role="dialog" aria-modal="true" aria-label="Site navigation">
      <header class="emn-head">
        <span class="emn-title">Menu</span>
        <button type="button" class="emn-close" data-emn-close aria-label="Close menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </header>
      <nav class="emn-links" aria-label="Mobile">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
        {%- endfor -%}
        <a href="{{ routes.search_url }}" class="emn-sec">Search</a>
        <a href="{{ routes.account_url }}" class="emn-sec">Account</a>
      </nav>
    </aside>
  </div>
  <script>
  (function(){
    var burger=document.getElementById('EastBurger');
    var nav=document.getElementById('EastMobileNav');
    if(!burger||!nav)return;
    function open(){nav.classList.add('on');nav.setAttribute('aria-hidden','false');burger.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';}
    function close(){nav.classList.remove('on');nav.setAttribute('aria-hidden','true');burger.setAttribute('aria-expanded','false');document.body.style.overflow='';}
    burger.addEventListener('click',function(){nav.classList.contains('on')?close():open();});
    nav.addEventListener('click',function(e){if(e.target.closest('[data-emn-close]')){e.preventDefault();close();}});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&nav.classList.contains('on'))close();});
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Eastiott"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The Collection" },
        { "type": "url", "id": "link", "label": "URL" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "The Collection", "link": "/collections/the-eastiott-collection" } },
      { "type": "link", "settings": { "label": "The Atelier Tote", "link": "/products/the-atelier-tote" } },
      { "type": "link", "settings": { "label": "Travel", "link": "/collections/the-eastiott-collection" } },
      { "type": "link", "settings": { "label": "Materials", "link": "/pages/materials" } },
      { "type": "link", "settings": { "label": "Our Story", "link": "/pages/about" } }
    ]
  }
}
{% endschema %}
