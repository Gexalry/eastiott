<section class="east-specs">
  <div class="wrap">
    <h2>{{ section.settings.heading | default: 'Considered in every dimension' }}</h2>
    <div class="spec-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="spec" {{ block.shopify_attributes }}>
            <span class="sk">{{ block.settings.label }}</span>
            <span class="sv">{{ block.settings.value }}</span>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign spec_labels = 'Dimensions|Weight|Laptop sleeve|Interior pockets|Exterior|Lining|Thermal hold|Warranty' | split: '|' -%}
        {%- assign spec_values = '5.5&Prime;D × 14.5&Prime;W × 17&Prime;H|1.1 lbs|Fits up to 17&Prime;|10, thoughtfully placed|Premium structured quilted leather|Leak-proof, easy-clean|5 hrs warm · 10 hrs cold|Lifetime' | split: '|' -%}
        {%- for i in (0..7) -%}
          <div class="spec">
            <span class="sk">{{ spec_labels[i] }}</span>
            <span class="sv">{{ spec_values[i] }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .east-specs { padding: 80px 0; }
  .east-specs h2 { font-family: var(--serif); font-size: 38px; text-align: center; margin-bottom: 46px; font-weight: 500; }
  .east-specs .spec-grid { display:grid; grid-template-columns: repeat(2,1fr); gap: 0 60px; max-width: 760px; margin: 0 auto; }
  @media (max-width:680px) { .east-specs .spec-grid { grid-template-columns:1fr; } }
  .east-specs .spec { display:flex; justify-content:space-between; padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 14.5px; }
  .east-specs .sk { color: var(--slate); letter-spacing: 0.04em; }
  .east-specs .sv { font-weight: 500; text-align: right; }
</style>

{% schema %}
{
  "name": "Product specs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Considered in every dimension" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Dimensions" },
        { "type": "text", "id": "value", "label": "Value", "default": "5.5\"D × 14.5\"W × 17\"H" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "spec", "settings": { "label": "Dimensions", "value": "5.5\"D × 14.5\"W × 17\"H" } },
      { "type": "spec", "settings": { "label": "Laptop fit", "value": "Up to 17\"" } },
      { "type": "spec", "settings": { "label": "Weight", "value": "1.1 lbs" } },
      { "type": "spec", "settings": { "label": "Material", "value": "Premium structured leather" } },
      { "type": "spec", "settings": { "label": "Closure", "value": "Smooth-glide zipper" } },
      { "type": "spec", "settings": { "label": "Thermal hold", "value": "5 hrs warm / 10 hrs cold" } }
    ]
  }
}
{% endschema %}
