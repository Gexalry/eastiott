<section class="east-featured-on" aria-labelledby="EastFeaturedLabel-{{ section.id }}">
  <div class="ft-label" id="EastFeaturedLabel-{{ section.id }}">{{ section.settings.label | default: 'As admired in' }}</div>
  <div class="logos" role="list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <span role="listitem" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
      {%- endfor -%}
    {%- else -%}
      {%- assign default_names = 'Vogue|Harper&rsquo;s Bazaar|The Cut|Cond&eacute; Nast Traveler|WSJ. Magazine|The Strategist' | split: '|' -%}
      {%- for name in default_names -%}
        <span role="listitem">{{ name }}</span>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .east-featured-on {
    padding: 54px 0; text-align: center;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .east-featured-on .ft-label {
    font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--slate); margin-bottom: 30px;
  }
  .east-featured-on .logos {
    display: flex; justify-content: center; align-items: center; gap: 56px;
    flex-wrap: wrap; font-family: var(--serif); font-size: 24px;
    color: var(--slate); opacity: 0.62; letter-spacing: 0.04em; font-style: italic;
  }
</style>

{% schema %}
{
  "name": "As admired in",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "As admired in" },
    { "type": "paragraph", "content": "These names are presentational only. Replace with real press mentions before publish to avoid implying endorsements you don't have." }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Name / logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "The Atelier" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "logo", "settings": { "name": "Vogue" } },
      { "type": "logo", "settings": { "name": "Harper’s Bazaar" } },
      { "type": "logo", "settings": { "name": "The Cut" } },
      { "type": "logo", "settings": { "name": "Condé Nast Traveler" } },
      { "type": "logo", "settings": { "name": "WSJ. Magazine" } },
      { "type": "logo", "settings": { "name": "The Strategist" } }
    ]
  }
}
{% endschema %}
