{%- if section.settings.message != blank -%}
  <div class="announce" role="region" aria-label="Announcement">{{ section.settings.message }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Complimentary shipping & gift wrap"
    }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
