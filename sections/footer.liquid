<footer class="site-footer" role="contentinfo">
  <div class="wrap">
    <div class="foot-top">
      <div>
        <div class="foot-logo">{{ section.settings.logo_text | default: 'Eastiott' }}</div>
        {%- if section.settings.tagline != blank -%}
          <div class="foot-tag">{{ section.settings.tagline }}</div>
        {%- endif -%}
      </div>
      <nav class="foot-links" aria-label="Footer">
        {%- for block in section.blocks -%}
          {%- if block.type == 'column' -%}
            <div class="foot-col" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              {%- assign link_pairs = block.settings.links | newline_to_br | split: '<br />' -%}
              {%- for raw_pair in link_pairs -%}
                {%- assign pair = raw_pair | strip -%}
                {%- if pair != blank -%}
                  {%- assign parts = pair | split: '|' -%}
                  {%- assign label = parts[0] | strip -%}
                  {%- assign url = parts[1] | default: '#' | strip -%}
                  <a href="{{ url }}">{{ label }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
    <div class="foot-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      {%- if section.settings.tagline_bottom != blank -%}
        <span>{{ section.settings.tagline_bottom }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Eastiott" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Carried with intention." },
    { "type": "text", "id": "tagline_bottom", "label": "Bottom tagline", "default": "Designed for those who carry more, gracefully." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links (one per line, format: Label | URL)",
          "default": "The Atelier Tote | /products/the-atelier-tote\nThe Collection | /collections/the-eastiott-collection\nAccessories | #\nGift Cards | #"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "heading": "Shop", "links": "The Atelier Tote | /products/the-atelier-tote\nThe Collection | /collections/the-eastiott-collection\nAccessories | #\nGift Cards | #" } },
      { "type": "column", "settings": { "heading": "House", "links": "Our Story | #\nMaterials | #\nTrack Your Order | #\nContact | #" } },
      { "type": "column", "settings": { "heading": "Policies", "links": "Privacy | /policies/privacy-policy\nRefunds | /policies/refund-policy\nShipping | /policies/shipping-policy\nTerms | /policies/terms-of-service" } }
    ]
  }
}
{% endschema %}
