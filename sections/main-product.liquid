{%- if template.name == 'product' -%}
  {%- comment -%} product is the page's product on product templates {%- endcomment -%}
{%- else -%}
  {%- assign product = section.settings.product -%}
{%- endif -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="east-pdp" id="EastPdp-{{ section.id }}">
  <div class="wrap">
    <div class="eyebrow eyebrow-top">
      {%- if section.settings.eyebrow_1 != blank -%}<span>{{ section.settings.eyebrow_1 }}</span>{%- endif -%}
      {%- if section.settings.eyebrow_2 != blank -%}<span>{{ section.settings.eyebrow_2 }}</span>{%- endif -%}
    </div>
  </div>
  <div class="wrap product-grid">
    <div class="gallery">
      <div class="hero-img" id="EastHero">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media limit: 1 -%}
            <img id="EastHeroImg" src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape | default: product.title }}" width="{{ media.width }}" height="{{ media.height }}" loading="eager" fetchpriority="high" decoding="async">
          {%- endfor -%}
        {%- else -%}
          <div class="crest">
            <svg viewBox="0 0 64 64" fill="none" stroke="var(--blue)" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M32 6c4 5 10 6 16 6-2 8 0 18-16 40C16 30 18 20 16 12c6 0 12-1 16-6Z"/><circle cx="32" cy="22" r="5"/><path d="M24 30h16M27 36h10"/></svg>
            <span class="ph">{{ product.title }}</span>
          </div>
        {%- endif -%}
      </div>
      {%- assign capacity_shot = 'https://d8j0ntlcm91z4.cloudfront.net/user_3CM0Z4osHXlzGBZ3LIRDjXy1o8z/hf_20260523_014924_2a099ab1-8bf4-4500-949c-690a860fe024_min.webp' -%}
      {%- if product.media.size > 0 or capacity_shot != blank -%}
        <div class="thumbs" id="EastThumbs">
          {%- for media in product.media limit: 4 -%}
            <button type="button" class="thumb{% if forloop.first %} active{% endif %}"{% if forloop.first %} aria-current="true"{% endif %} data-full="{{ media | image_url: width: 1200 }}" data-alt="{{ media.alt | escape }}" aria-label="{% if media.alt != blank %}View {{ media.alt | escape }}{% else %}View image {{ forloop.index }} of {{ product.title | escape }}{% endif %}"><img src="{{ media | image_url: width: 240 }}" alt="" loading="lazy" decoding="async"></button>
          {%- endfor -%}
          <button type="button" class="thumb" data-full="{{ capacity_shot }}" data-alt="Inside the Atelier — everything in its place" aria-label="View interior of {{ product.title | escape }}"><img src="{{ capacity_shot }}" alt="" loading="lazy" decoding="async"></button>
        </div>
      {%- endif -%}
    </div>

    <div class="buybox">
      {%- if section.settings.show_rating -%}
        <div class="rating-row"><span class="stars" aria-hidden="true">★★★★★</span><span><span class="visually-hidden">Rated </span><b>{{ section.settings.rating_value }}</b> · {{ section.settings.rating_label }}</span></div>
      {%- endif -%}

      <h1 class="title">{{ product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}<div class="subtitle">{{ section.settings.subtitle }}</div>{%- endif -%}

      {%- if section.settings.bullets != blank -%}
        <ul class="bullets">
          {%- assign bullet_lines = section.settings.bullets | newline_to_br | split: '<br />' -%}
          {%- for bullet in bullet_lines -%}
            {%- assign bullet_text = bullet | strip -%}
            {%- if bullet_text != blank -%}<li>{{ bullet_text }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="EastForm" novalidate>
        {%- for option in product.options_with_values -%}
          <div class="label"><span>{{ option.name }}</span><span class="pick" data-option-pick="{{ forloop.index0 }}">{{ option.selected_value }}</span></div>
          <div class="swatches" data-option-index="{{ forloop.index0 }}">
            {%- for value in option.values -%}
              <button type="button" class="sw{% if value == option.selected_value %} on{% endif %}" data-option-index="{{ forloop.index0 | plus: 0 }}" data-value="{{ value | escape }}" style="--swatch:{{ value | handle | prepend: '#' | replace: '#white-black', 'linear-gradient(135deg,#efe8dc 0 50%,#1c1c1c 50% 100%)' | replace: '#champagne', '#cdbfa6' | replace: '#classic-black', '#1c1c1c' | replace: '#black', '#1c1c1c' | replace: '#brown', '#6b4e34' | replace: '#blue', '#006B95' | replace: '#slate', '#4F5B65' | replace: '#green', '#5b6650' | replace: '#beige', '#cdbfa6' | replace: '#purple', '#6a4c75' | replace: '#white', '#efe8dc' }};" title="{{ value | escape }}" aria-label="{{ option.name }}: {{ value }}"></button>
            {%- endfor -%}
          </div>
        {%- endfor -%}

        <input type="hidden" name="id" id="EastVariantId" value="{{ current_variant.id }}">

        {%- if section.blocks.size > 0 -%}
          <div class="tiers" id="EastTiers" role="radiogroup" aria-label="Bundle quantity">
            {%- for block in section.blocks -%}
              {%- if block.type == 'tier' -%}
                {%- assign tier_qty = block.settings.quantity | default: 1 -%}
                {%- assign tier_disc = block.settings.discount_percent | default: 0 -%}
                {%- assign tier_gross = current_variant.price | times: tier_qty -%}
                {%- assign tier_off = tier_gross | times: tier_disc | divided_by: 100 -%}
                {%- assign tier_net = tier_gross | minus: tier_off -%}
                {%- assign tier_id = 'EastTier-' | append: section.id | append: '-' | append: block.id -%}
                <div class="tier-wrap{% if block.settings.selected %} on{% endif %}" data-qty="{{ tier_qty }}" data-disc="{{ tier_disc }}" {{ block.shopify_attributes }}>
                  <label class="tier" for="{{ tier_id }}">
                    <input type="radio" name="east-tier-{{ section.id }}" id="{{ tier_id }}" class="tier-input visually-hidden" value="{{ block.id }}"{% if block.settings.selected %} checked{% endif %}>
                    {%- if block.settings.flag != blank -%}<span class="flag">{{ block.settings.flag }}</span>{%- endif -%}
                    <span class="radio" aria-hidden="true"></span>
                    <span class="ti"><span class="tname">{{ block.settings.name }}</span><span class="tsub">{{ block.settings.subtitle }}</span></span>
                    <span class="tprice"><b class="tprice-now">{{ tier_net | money }}</b>{%- if current_variant.compare_at_price > current_variant.price -%}<s class="tprice-was">{{ current_variant.compare_at_price | times: tier_qty | money }}</s>{%- else -%}<s class="tprice-was" hidden></s>{%- endif -%}</span>
                  </label>
                  <div class="tier-colors" hidden></div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign addon_handles = 'warranty-shipping-protection|matching-purse|matching-shoulder-strap|signature-gift-wrap' | split: '|' -%}
        {%- assign addon_settings_labels = section.settings.addon_warranty | append: '||' | append: section.settings.addon_1 | append: '||' | append: section.settings.addon_2 | append: '||' | append: section.settings.addon_3 | split: '||' -%}
        {%- assign addon_defaults = '' -%}
        {%- if section.settings.addon_warranty_on -%}{%- assign addon_defaults = addon_defaults | append: '1|' -%}{%- else -%}{%- assign addon_defaults = addon_defaults | append: '0|' -%}{%- endif -%}
        {%- if section.settings.addon_1_on -%}{%- assign addon_defaults = addon_defaults | append: '1|' -%}{%- else -%}{%- assign addon_defaults = addon_defaults | append: '0|' -%}{%- endif -%}
        {%- if section.settings.addon_2_on -%}{%- assign addon_defaults = addon_defaults | append: '1|' -%}{%- else -%}{%- assign addon_defaults = addon_defaults | append: '0|' -%}{%- endif -%}
        {%- if section.settings.addon_3_on -%}{%- assign addon_defaults = addon_defaults | append: '1' -%}{%- else -%}{%- assign addon_defaults = addon_defaults | append: '0' -%}{%- endif -%}
        {%- assign addon_default_flags = addon_defaults | split: '|' -%}
        {%- comment -%}Shipping protection auto-adds to cart (not shown as checkbox){%- endcomment -%}
        {%- assign sp_product = all_products['warranty-shipping-protection'] -%}
        {%- if sp_product.variants.first -%}
          <input type="hidden" id="EastShipProtect" data-variant-id="{{ sp_product.variants.first.id }}">
        {%- endif -%}
        <div class="addons">
          {%- for handle in addon_handles -%}
            {%- if handle == 'warranty-shipping-protection' -%}{%- continue -%}{%- endif -%}
            {%- assign addon_product = all_products[handle] -%}
            {%- assign addon_variant = addon_product.variants.first -%}
            {%- if addon_variant -%}
              {%- assign label_raw = addon_settings_labels[forloop.index0] | strip -%}
              {%- assign is_on = addon_default_flags[forloop.index0] -%}
              {%- assign addon_id = 'EastAddon-' | append: section.id | append: '-' | append: forloop.index0 -%}
              <label class="addon{% if is_on == '1' %} on{% endif %}" for="{{ addon_id }}">
                <input type="checkbox" id="{{ addon_id }}" class="addon-input visually-hidden" data-variant-id="{{ addon_variant.id }}"{% if is_on == '1' %} checked{% endif %}>
                <span class="ck" aria-hidden="true"></span>
                <span class="an">{%- if label_raw contains ' · ' -%}<b>{{ label_raw | split: ' · ' | first }}</b> · {{ label_raw | split: ' · ' | last }}{%- else -%}<b>{{ label_raw }}</b>{%- endif -%}</span>
                <span class="ap">
                  {%- if addon_variant.price == 0 -%}
                    <span class="free">Free</span>
                  {%- else -%}
                    {{ addon_variant.price | money }}
                  {%- endif -%}
                  {%- if addon_variant.compare_at_price and addon_variant.compare_at_price > addon_variant.price -%}<s>{{ addon_variant.compare_at_price | money }}</s>{%- endif -%}
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button type="submit" class="cta" {% unless current_variant.available %}disabled{% endunless %}>
          {%- if current_variant.available -%}{{ section.settings.cta_text | default: 'Add to Cart' }} · <span id="EastCtaPrice">{{ current_variant.price | money }}</span>{%- else -%}Sold Out{%- endif -%}
        </button>
      </form>

      {%- if section.settings.ship_note != blank -%}<div class="ship-note">{{ section.settings.ship_note }}</div>{%- endif -%}
      {%- if section.settings.guarantee != blank -%}<div class="guarantee"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4Zm-1.2 15-3.5-3.5 1.4-1.4 2.1 2.1 4.6-4.6 1.4 1.4-6 6Z"/></svg>{{ section.settings.guarantee }}</div>{%- endif -%}
    </div>
  </div>
</section>

<style>
.east-pdp .product-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;padding:56px 0 72px}
@media(max-width:980px){.east-pdp .product-grid{grid-template-columns:1fr;gap:32px}}
@media(max-width:720px){.east-pdp .product-grid{padding:0 0 56px;gap:16px}}
@media(max-width:720px){.east-pdp .hero-img{aspect-ratio:4/5}}
@media(max-width:720px){.east-pdp .thumbs{display:none}}
@media(max-width:720px){.east-pdp .eyebrow-top{padding:10px 0 8px}}
@media(max-width:720px){.east-pdp .bullets{display:none}}
@media(max-width:720px){.east-pdp .rating-row{margin-bottom:10px}}
@media(max-width:720px){.east-pdp h1.title{font-size:clamp(28px,8vw,42px);margin-bottom:4px}}
@media(max-width:720px){.east-pdp .subtitle{font-size:17px;margin-bottom:14px}}
@media(max-width:720px){.east-pdp .swatches{margin-bottom:18px}}
@media(max-width:720px){.east-pdp .sw{width:36px;height:36px}}
@media(max-width:720px){.east-pdp .tiers{gap:8px;margin-bottom:18px}}
@media(max-width:720px){.east-pdp .tier{padding:12px 14px;gap:12px}}
@media(max-width:720px){.east-pdp .addons{gap:6px;margin-bottom:18px}}
@media(max-width:720px){.east-pdp .addon{padding:9px 12px;font-size:12px}}
.east-pdp .gallery{position:sticky;top:98px;align-self:start}
@media(max-width:980px){.east-pdp .gallery{position:static}}
.east-pdp .hero-img{aspect-ratio:1;border-radius:3px;overflow:hidden;background:linear-gradient(150deg,#dfe6ea,#cdd6db);display:flex;align-items:center;justify-content:center}
.east-pdp .hero-img img{width:100%;height:100%;object-fit:cover}
.east-pdp .crest{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px}
.east-pdp .crest svg{width:78px;height:78px;opacity:.42}
.east-pdp .thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:12px}
.east-pdp .thumb{aspect-ratio:1;border-radius:2px;overflow:hidden;cursor:pointer;border:1px solid transparent;background:var(--paper-2);padding:0;transition:border-color .25s}
.east-pdp .thumb img{width:100%;height:100%;object-fit:cover}
.east-pdp .thumb:hover,.east-pdp .thumb.active{border-color:var(--gold)}
.east-pdp .eyebrow{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--slate);margin-bottom:20px}
.east-pdp .eyebrow-top{padding:28px 0 18px;margin-bottom:0}
@media(max-width:720px){.east-pdp .eyebrow-top{padding:18px 0 14px}}
.east-pdp .eyebrow span{display:block}
.east-pdp .eyebrow b{font-weight:600;color:var(--ink)}
.east-pdp .eyebrow i{font-style:italic}
.east-pdp .rating-row{display:flex;align-items:center;gap:12px;margin-bottom:18px;font-size:13px;color:var(--slate);letter-spacing:.04em}
.east-pdp .rating-row b{color:var(--ink);font-weight:500}
.east-pdp .stars{color:var(--gold);letter-spacing:3px;font-size:15px}
.east-pdp h1.title{font-family:var(--serif);font-size:clamp(34px,9vw,54px);line-height:1.02;font-weight:500;letter-spacing:.01em;margin-bottom:6px}
.east-pdp .subtitle{font-family:var(--serif);font-style:italic;font-size:21px;color:var(--slate);margin-bottom:24px}
.east-pdp .price-row{display:flex;align-items:baseline;gap:14px;margin-bottom:4px;flex-wrap:wrap}
.east-pdp .price{font-size:30px;font-weight:400;color:var(--blue)}
.east-pdp .was{font-size:18px;color:var(--slate);text-decoration:line-through}
.east-pdp .save{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:var(--red);padding:3px 9px;border-radius:2px}
.east-pdp .unit{font-size:11.5px;color:var(--slate);letter-spacing:.06em;margin-bottom:24px}
.east-pdp .bullets{list-style:none;margin:0 0 30px;display:grid;gap:11px;padding:0}
.east-pdp .bullets li{display:flex;gap:11px;font-size:14.5px;color:var(--ink);align-items:flex-start}
.east-pdp .bullets li::before{content:"";width:16px;height:16px;flex:0 0 16px;margin-top:3px;border-radius:50%;background:var(--blue)}
.east-pdp .label{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--slate);margin-bottom:11px;display:flex;justify-content:space-between}
.east-pdp .label .pick{color:var(--ink)}
.east-pdp .swatches{display:flex;gap:11px;flex-wrap:wrap;margin-bottom:28px;position:relative}
.east-pdp .sw{width:42px;height:42px;border-radius:50%;cursor:pointer;border:1px solid var(--line);padding:0;transition:transform .2s;background:var(--swatch,var(--slate));position:relative}
.east-pdp .sw:hover{transform:scale(1.07)}
.east-pdp .sw.on{box-shadow:0 0 0 1.5px var(--paper),0 0 0 3px var(--gold)}
.east-pdp .sw-preview{position:absolute;bottom:calc(100% + 14px);left:0;width:148px;display:flex;flex-direction:column;align-items:center;gap:7px;padding:8px 8px 10px;background:#fff;border:1px solid var(--line);border-radius:3px;box-shadow:0 8px 22px rgba(0,0,0,.09);opacity:0;pointer-events:none;transition:opacity .18s ease, transform .18s ease;transform:translate(-50%,4px);z-index:6}
.east-pdp .sw-preview.on{opacity:1;transform:translate(-50%,0)}
.east-pdp .sw-preview img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:2px;background:var(--paper-2);display:block}
.east-pdp .sw-preview .sw-pdot{width:28px;height:28px;border-radius:50%;border:1px solid var(--line);background:var(--swatch,var(--slate))}
.east-pdp .sw-preview .sw-pname{font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink);font-weight:500;text-align:center}
.east-pdp .sw-preview::after{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:6px solid var(--line)}
.east-pdp .sw-preview::before{content:"";position:absolute;top:calc(100% - 1px);left:50%;transform:translateX(-50%);width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:6px solid #fff;z-index:1}
@media(hover:none){.east-pdp .sw-preview{display:none}}
.east-pdp .hero-img img{transition:opacity .22s ease}
.east-pdp .hero-img.swapping img{opacity:0}
.east-pdp .tiers{display:grid;gap:12px;margin-bottom:26px}
.east-pdp .tier-wrap{border:1px solid var(--line);border-radius:4px;transition:border-color .25s,background .25s;position:relative;background:#fff}
.east-pdp .tier-wrap:hover{border-color:var(--gold-soft)}
.east-pdp .tier-wrap.on{border-color:var(--blue)}
.east-pdp .tier{padding:16px 18px;cursor:pointer;display:flex;align-items:center;gap:15px}
.east-pdp .tier .radio{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--slate);flex:0 0 18px;position:relative;transition:border-color .2s}
.east-pdp .tier-wrap.on .tier .radio{border-color:var(--blue)}
.east-pdp .tier-wrap.on .tier .radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--blue)}
.east-pdp .tier .ti{flex:1;display:flex;flex-direction:column}
.east-pdp .tier .tname{font-size:15px;font-weight:500;letter-spacing:.02em}
.east-pdp .tier .tsub{font-size:11.5px;color:var(--slate);letter-spacing:.04em}
.east-pdp .tier .tprice{text-align:right;display:flex;flex-direction:column}
.east-pdp .tier .tprice b{font-size:17px;font-weight:500;color:var(--blue)}
.east-pdp .tier .tprice s{display:block;font-size:12px;color:var(--slate)}
.east-pdp .tier .flag{position:absolute;top:-9px;right:14px;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;background:var(--gold);color:var(--ink);padding:2px 9px;border-radius:2px}
.east-pdp .tier-colors{background:var(--paper-2);border-top:1px solid var(--line);padding:8px 18px 14px;overflow:hidden;border-radius:0 0 4px 4px}
.east-pdp .tier-colors .bp-row{display:flex;align-items:center;gap:12px;padding:8px 0;border-top:1px solid var(--line)}
.east-pdp .tier-colors .bp-row:first-of-type{border-top:0}
.east-pdp .tier-colors .bp-num{font-family:var(--serif);font-size:15px;color:var(--ink);width:30px;font-weight:500}
.east-pdp .tier-colors .bp-sw{width:24px;height:24px;border-radius:50%;border:1px solid var(--line);flex:0 0 24px;transition:width .15s, height .15s, border-radius .15s}
.east-pdp .tier-colors .bp-sw.has-img{width:34px;height:34px;border-radius:4px;flex:0 0 34px}
.east-pdp .tier-colors .bp-color{flex:1;background:#fff;border:1px solid var(--line);border-radius:3px;padding:9px 12px;font-family:var(--sans);font-size:14px;color:var(--ink);cursor:pointer;appearance:none;-webkit-appearance:none;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8' fill='%234F5B65'><path d='M6 8 0 0h12z'/></svg>");background-repeat:no-repeat;background-position:right 12px center;background-size:9px;padding-right:32px}
.east-pdp .addons{display:grid;gap:9px;margin-bottom:26px}
.east-pdp .addon{display:flex;align-items:center;gap:13px;border:1px dashed var(--line);border-radius:4px;padding:11px 14px;font-size:13px;cursor:pointer}
.east-pdp .addon .ck{width:18px;height:18px;border-radius:3px;border:1.5px solid var(--slate);flex:0 0 18px;transition:.2s;position:relative}
.east-pdp .addon.on .ck{background:var(--blue);border-color:var(--blue)}
.east-pdp .addon .an{flex:1}
.east-pdp .addon .ap .free{color:var(--gold);font-weight:500}
.east-pdp .addon .ap s{color:var(--slate);margin-left:5px}
.east-pdp .cta{width:100%;border:none;background:var(--blue);color:#fff;font-family:var(--sans);font-size:14px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;padding:19px;border-radius:4px;cursor:pointer;transition:background .25s,transform .15s}
.east-pdp .cta:hover{background:var(--blue-deep)}
.east-pdp .cta[disabled]{background:var(--slate);cursor:not-allowed}
.east-pdp .ship-note{text-align:center;font-size:12px;color:var(--slate);letter-spacing:.05em;margin-top:12px}
.east-pdp .guarantee{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:16px;font-size:12.5px;color:var(--slate);letter-spacing:.04em}
.east-pdp .guarantee svg{width:16px;height:16px;fill:var(--gold)}
</style>

<script>
(function(){
  var section=document.getElementById('EastPdp-{{ section.id }}');
  if(!section)return;
  var productJson={{ product.variants | json }};
  if(!Array.isArray(productJson))productJson=[];
  var optionCount={{ product.options.size }};
  if(!(optionCount>0))optionCount=0;
  var hiddenId=section.querySelector('#EastVariantId');
  var ctaPriceEl=section.querySelector('#EastCtaPrice');
  var ctaBtn=section.querySelector('.cta');
  var heroImg=section.querySelector('#EastHeroImg');
  var heroWrap=section.querySelector('.hero-img');
  var thumbs=section.querySelectorAll('.thumb');
  var selected=[];
  section.querySelectorAll('.label .pick').forEach(function(el,i){selected[i]=el.textContent.trim();});
  var activeCurrency='{{ localization.country.currency.iso_code | default: "USD" }}';
  var moneyFmt;
  try{moneyFmt=new Intl.NumberFormat((navigator&&navigator.language)||'en-US',{style:'currency',currency:activeCurrency});}catch(e){moneyFmt=null;}
  function moneyFormat(c){
    if(moneyFmt)return moneyFmt.format(c/100);
    return '{{ shop.money_format }}'.replace(/\{\{\s*amount[^}]*\}\}/,(c/100).toFixed(2));
  }
  function variantImage(v){return v&&v.featured_image&&v.featured_image.src?v.featured_image.src:null;}
  function swapHero(url,alt){
    if(!heroImg||!url)return;
    if(heroImg.src===url)return;
    if(heroWrap)heroWrap.classList.add('swapping');
    var next=new Image();
    next.onload=function(){heroImg.src=url;if(alt)heroImg.alt=alt;if(heroWrap)heroWrap.classList.remove('swapping');thumbs.forEach(function(x){x.classList.remove('active');x.removeAttribute('aria-current');});};
    next.onerror=function(){
      if(heroWrap)heroWrap.classList.remove('swapping');
      try{if(window.console&&console.warn)console.warn('[east-pdp] hero image failed to load:',url);}catch(_){}
    };
    next.src=url;
  }
  function syncTierPrices(v){
    if(!v||typeof v.price!=='number')return;
    section.querySelectorAll('.tier-wrap').forEach(function(w){
      var qty=parseInt(w.dataset.qty,10)||1;
      var disc=parseInt(w.dataset.disc,10)||0;
      var gross=v.price*qty;
      var net=gross-Math.round(gross*disc/100);
      var nowEl=w.querySelector('.tprice-now');
      var wasEl=w.querySelector('.tprice-was');
      if(nowEl)nowEl.textContent=moneyFormat(net);
      if(wasEl){
        if(v.compare_at_price&&v.compare_at_price>v.price){wasEl.textContent=moneyFormat(v.compare_at_price*qty);wasEl.hidden=false;}
        else{wasEl.hidden=true;}
      }
    });
  }
  function escapeHtml(s){var d=document.createElement('div');d.textContent=s==null?'':s;return d.innerHTML;}
  function sync(v){
    if(!v||!hiddenId)return;
    hiddenId.value=v.id;
    if(ctaPriceEl)ctaPriceEl.textContent=moneyFormat(v.price);
    if(ctaBtn){
      if(v.available){
        ctaBtn.disabled=false;
        ctaBtn.innerHTML='{{ section.settings.cta_text | default: "Add to Cart" | escape }} · <span id="EastCtaPrice">'+escapeHtml(moneyFormat(v.price))+'</span>';
        ctaPriceEl=ctaBtn.querySelector('#EastCtaPrice');
      }else{
        ctaBtn.disabled=true;
        ctaBtn.textContent='Sold Out';
      }
    }
    syncTierPrices(v);
    var img=variantImage(v);
    if(img&&v.featured_image)swapHero(img,v.featured_image.alt||'');
  }
  function find(){return productJson.find(function(v){if(!v||!v.options||v.options.length<optionCount)return false;for(var i=0;i<optionCount;i++){if(v.options[i]!==selected[i])return false;}return true;});}
  function variantForSwatch(idx,value){
    // Prefer a variant where all other selected options also match; fall back to any variant with that value.
    var probe=selected.slice();probe[idx]=value;
    var v=productJson.find(function(x){if(!x||!x.options||x.options.length<optionCount)return false;for(var i=0;i<optionCount;i++){if(x.options[i]!==probe[i])return false;}return true;});
    return v||productJson.find(function(x){return x&&x.options&&x.options[idx]===value;});
  }
  section.querySelectorAll('.swatches').forEach(function(g){
    var idx=parseInt(g.dataset.optionIndex,10);
    var preview=document.createElement('div');
    preview.className='sw-preview';
    preview.innerHTML='<img alt="" loading="lazy" decoding="async"><span class="sw-pname"></span>';
    var pimg=preview.querySelector('img');
    var pdot=null;
    var pname=preview.querySelector('.sw-pname');
    g.appendChild(preview);
    var hideTimer=null;
    function showFor(sw){
      if(hideTimer){clearTimeout(hideTimer);hideTimer=null;}
      var value=sw.dataset.value;
      var v=variantForSwatch(idx,value);
      var img=variantImage(v);
      if(img){
        pimg.src=img;
        pimg.style.display='';
        if(pdot){pdot.remove();pdot=null;}
      }else{
        pimg.style.display='none';
        if(!pdot){pdot=document.createElement('span');pdot.className='sw-pdot';preview.insertBefore(pdot,pname);}
        pdot.style.background=sw.style.getPropertyValue('--swatch')||'';
      }
      pname.textContent=value;
      preview.classList.add('on');
      var center=sw.offsetLeft+sw.offsetWidth/2;
      var pw=preview.offsetWidth||148;
      var gw=g.clientWidth;
      var minX=pw/2, maxX=gw-pw/2;
      if(minX>maxX){minX=maxX=gw/2;}
      preview.style.left=Math.max(minX,Math.min(maxX,center))+'px';
    }
    function hide(){hideTimer=setTimeout(function(){preview.classList.remove('on');},80);}
    g.querySelectorAll('.sw').forEach(function(sw){
      sw.addEventListener('mouseenter',function(){showFor(sw);});
      sw.addEventListener('focus',function(){showFor(sw);});
      sw.addEventListener('mouseleave',hide);
      sw.addEventListener('blur',hide);
      sw.addEventListener('click',function(){
        g.querySelectorAll('.sw').forEach(function(x){x.classList.remove('on');});
        sw.classList.add('on');
        selected[idx]=sw.dataset.value;
        var p=section.querySelector('.label .pick[data-option-pick="'+idx+'"]');
        if(p)p.textContent=sw.dataset.value;
        var v=find();
        if(v)sync(v);
      });
    });
  });
  function swatchColor(value){
    var h=value.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
    var map={'white-black':'linear-gradient(135deg,#efe8dc 0 50%,#1c1c1c 50% 100%)','champagne':'#cdbfa6','classic-black':'#1c1c1c','black':'#1c1c1c','brown':'#6b4e34','blue':'#006B95','slate':'#4F5B65','green':'#5b6650','beige':'#cdbfa6','purple':'#6a4c75','white':'#efe8dc'};
    return map[h]||'#4F5B65';
  }
  function paintBpSw(sw,v){
    var img=variantImage(v);
    if(img){
      sw.style.background="#fff url('"+img+"') center/cover no-repeat";
      sw.classList.add('has-img');
    }else{
      sw.style.background=v?swatchColor(v.options[0]):'';
      sw.classList.remove('has-img');
    }
  }
  function renderTierColors(tierWrap){
    var container=tierWrap.querySelector('.tier-colors');
    if(!container)return;
    var qty=parseInt(tierWrap.dataset.qty,10)||1;
    if(qty<2){container.hidden=true;container.innerHTML='';return;}
    var defaultId=hiddenId.value;
    var existing=Array.prototype.map.call(container.querySelectorAll('.bp-color'),function(s){return s.value;});
    container.innerHTML='';
    for(var i=0;i<qty;i++){
      var row=document.createElement('div');row.className='bp-row';
      var num=document.createElement('span');num.className='bp-num';num.textContent='#'+(i+1);
      var sw=document.createElement('span');sw.className='bp-sw';
      var sel=document.createElement('select');sel.className='bp-color';sel.dataset.bagIndex=i;
      productJson.forEach(function(v){
        var opt=document.createElement('option');opt.value=v.id;opt.textContent=v.options[0];
        sel.appendChild(opt);
      });
      sel.value=existing[i]||defaultId;
      var chosen=productJson.find(function(v){return String(v.id)===String(sel.value);});
      paintBpSw(sw,chosen);
      sel.addEventListener('change',function(){
        var v=productJson.find(function(x){return String(x.id)===String(this.value);}.bind(this));
        paintBpSw(this.parentElement.querySelector('.bp-sw'),v);
      });
      row.appendChild(num);row.appendChild(sw);row.appendChild(sel);
      container.appendChild(row);
    }
    container.hidden=false;
  }
  function activateTier(wrap){
    section.querySelectorAll('.tier-wrap').forEach(function(x){x.classList.remove('on');var c=x.querySelector('.tier-colors');if(c){c.hidden=true;c.innerHTML='';}});
    wrap.classList.add('on');
    renderTierColors(wrap);
  }
  section.querySelectorAll('.tier-input').forEach(function(input){
    input.addEventListener('change',function(){
      if(input.checked)activateTier(input.closest('.tier-wrap'));
    });
  });
  var initialWrap=section.querySelector('.tier-wrap.on');
  if(initialWrap)renderTierColors(initialWrap);
  section.querySelectorAll('.addon-input').forEach(function(input){
    input.addEventListener('change',function(){
      input.closest('.addon').classList.toggle('on',input.checked);
    });
  });
  var form=section.querySelector('#EastForm');
  if(form){form.addEventListener('submit',function(e){
    e.preventDefault();
    var items=[];
    var activeWrap=section.querySelector('.tier-wrap.on');
    var bundleSelects=activeWrap?activeWrap.querySelectorAll('.tier-colors:not([hidden]) .bp-color'):[];
    if(bundleSelects.length>0){
      var counts={};
      bundleSelects.forEach(function(sel){counts[sel.value]=(counts[sel.value]||0)+1;});
      Object.keys(counts).forEach(function(vid){items.push({id:parseInt(vid,10),quantity:counts[vid]});});
    }else{
      items.push({id:parseInt(hiddenId.value,10),quantity:1});
    }
    section.querySelectorAll('.addon-input:checked').forEach(function(input){
      var vid=parseInt(input.dataset.variantId,10);
      if(vid)items.push({id:vid,quantity:1});
    });
    var sp=document.getElementById('EastShipProtect');
    if(sp){var spId=parseInt(sp.dataset.variantId,10);if(spId)items.push({id:spId,quantity:1});}
    if(ctaBtn&&!ctaBtn.dataset.original){ctaBtn.dataset.original=ctaBtn.innerHTML;}
    if(ctaBtn){ctaBtn.disabled=true;ctaBtn.textContent='Adding…';}
    if(window.eastiottCart&&window.eastiottCart.open){window.eastiottCart.open();}
    var restoreCta=function(){if(ctaBtn){ctaBtn.disabled=false;ctaBtn.innerHTML=ctaBtn.dataset.original||'Add to Cart';}};
    fetch('{{ routes.cart_url }}/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
      .then(function(r){if(!r.ok)throw new Error('cart-add failed: '+r.status);return r.json();})
      .then(function(){
        restoreCta();
        if(window.eastiottCart&&window.eastiottCart.refresh){window.eastiottCart.refresh();}
        else if(!window.eastiottCart){window.location.href='{{ routes.cart_url }}';}
      })
      .catch(function(err){
        restoreCta();
        try{if(window.console&&console.warn)console.warn('[east-pdp] add-to-cart failed:',err);}catch(_){}
        window.alert('Sorry — something went wrong adding to cart. Please try again.');
      });
  });}
  thumbs.forEach(function(t){t.addEventListener('click',function(){
    thumbs.forEach(function(x){x.classList.remove('active');x.removeAttribute('aria-current');});
    t.classList.add('active');
    t.setAttribute('aria-current','true');
    if(heroImg&&t.dataset.full){
      try{
        heroImg.onerror=function(){try{if(window.console&&console.warn)console.warn('[east-pdp] thumb image failed to load:',t.dataset.full);}catch(_){}};
      }catch(_){}
      heroImg.src=t.dataset.full;
      heroImg.alt=t.dataset.alt||heroImg.alt;
    }
  });});
})();
</script>

{% schema %}
{
  "name": "Product — Atelier",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (only used outside product templates)" },
    { "type": "header", "content": "Eyebrow tags" },
    { "type": "text", "id": "eyebrow_1", "label": "Eyebrow 1", "default": "2026 Top Rated - Built By Women" },
    { "type": "text", "id": "eyebrow_2", "label": "Eyebrow 2", "default": "Overstock Sale [Limited Time]" },
    { "type": "header", "content": "Rating (placeholder)" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating line", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8/5" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Excellent · 12,500+ reviews" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Three bags, refined into one." },
    { "type": "text", "id": "unit_note", "label": "Unit / price note", "default": "Unit price / per" },
    { "type": "textarea", "id": "bullets", "label": "Buy-box bullets (one per line)", "default": "No more juggling lunch bags, laptops, and handbags\nInsulated compartment keeps meals warm 5 hrs, cold 10 hrs\nFits laptops up to 17\" — work, travel, and beyond\nCrafted to be carried for years, not seasons" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Add to Cart" },
    { "type": "text", "id": "ship_note", "label": "Ship note", "default": "Ships today · Tracked shipping worldwide" },
    { "type": "text", "id": "guarantee", "label": "Guarantee", "default": "30-day money-back guarantee" },
    { "type": "header", "content": "Add-ons", "info": "Labels can include ` · ` to split into a bold lead + lighter trailing phrase. Price comes from the linked product (warranty-shipping-protection, matching-purse, matching-shoulder-strap, signature-gift-wrap)." },
    { "type": "text", "id": "addon_warranty", "label": "Warranty addon label", "default": "Shipping Protection · against loss or damage in transit" },
    { "type": "checkbox", "id": "addon_warranty_on", "label": "Warranty selected by default", "default": true },
    { "type": "text", "id": "addon_1", "label": "Add-on 1 label", "default": "Matching purse · same colour as your tote" },
    { "type": "checkbox", "id": "addon_1_on", "label": "Add-on 1 selected by default", "default": true },
    { "type": "text", "id": "addon_2", "label": "Add-on 2 label", "default": "Matching shoulder strap" },
    { "type": "checkbox", "id": "addon_2_on", "label": "Add-on 2 selected by default", "default": false },
    { "type": "text", "id": "addon_3", "label": "Add-on 3 label", "default": "Signature gift wrap" },
    { "type": "checkbox", "id": "addon_3_on", "label": "Add-on 3 selected by default", "default": true }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "One Tote" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The signature carry" },
        { "type": "number", "id": "quantity", "label": "Quantity", "default": 1, "info": "How many of the product this tier sells." },
        { "type": "range", "id": "discount_percent", "label": "Bundle discount %", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 0, "info": "Applied to the live variant price. The Shopify compare-at is shown automatically." },
        { "type": "text", "id": "flag", "label": "Flag (e.g. Best Value)" },
        { "type": "checkbox", "id": "selected", "label": "Selected by default", "default": false }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "tier", "settings": { "name": "One Tote", "subtitle": "The signature carry", "quantity": 1, "discount_percent": 0, "selected": true } },
      { "type": "tier", "settings": { "name": "Two Totes", "subtitle": "One to keep, one to gift", "quantity": 2, "discount_percent": 5, "flag": "Flash Sale" } },
      { "type": "tier", "settings": { "name": "Three Totes", "subtitle": "The family set", "quantity": 3, "discount_percent": 10, "flag": "Best Value" } }
    ]
  },
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
