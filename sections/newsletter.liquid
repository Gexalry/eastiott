<div class="east-news">
  <h3>{{ section.settings.heading | default: 'The List' }}</h3>
  {%- if section.settings.body != blank -%}
    <p>{{ section.settings.body }}</p>
  {%- endif -%}
  {% form 'customer', class: 'east-news-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
    <button type="submit">{{ section.settings.button_text | default: 'Sign Up' }}</button>
    {%- if form.posted_successfully? -%}
      <div class="east-news-msg ok">Thank you — you're on the list.</div>
    {%- elsif form.errors -%}
      <div class="east-news-msg err">{{ form.errors | default_errors }}</div>
    {%- endif -%}
  {% endform %}
</div>

<style>
  .east-news { background: var(--blue); color: #fff; text-align: center; padding: 64px 24px; }
  .east-news h3 { font-family: var(--serif); font-size: 34px; font-weight: 500; margin-bottom: 10px; }
  .east-news p { opacity: 0.85; font-size: 14px; letter-spacing: 0.04em; margin-bottom: 26px; }
  .east-news form { display: flex; gap: 10px; max-width: 440px; margin: 0 auto; flex-wrap: wrap; justify-content: center; }
  .east-news input[type="email"] {
    flex: 1; min-width: 220px; padding: 14px 16px;
    border: 1px solid rgba(255,255,255,0.6); background: rgba(255,255,255,0.1);
    color: #fff; border-radius: 3px; font-family: var(--sans); font-size: 14px;
  }
  .east-news input::placeholder { color: rgba(255,255,255,0.78); }
  .east-news button {
    background: var(--gold); color: #fff; border: none;
    padding: 14px 26px; border-radius: 3px;
    font-family: var(--sans); letter-spacing: 0.14em; text-transform: uppercase;
    font-size: 12px; font-weight: 500; cursor: pointer; transition: background .2s;
  }
  .east-news button:hover { background: var(--gold-soft); }
  .east-news-msg { width: 100%; margin-top: 16px; font-size: 13px; letter-spacing: 0.04em; }
  .east-news-msg.ok { color: #fff; }
  .east-news-msg.err { color: #ffd9d9; }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The List" },
    { "type": "text", "id": "body", "label": "Body", "default": "Quiet news, early access, and the occasional discreet discount." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Sign Up" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
